local function clearChildren(frame)
	for _, child in ipairs(frame:GetChildren()) do
		if child:IsA("GuiObject") then
			child:Destroy()
		end
	end
end

local currentTab = "Self"
local selectedRail = 1
local railButtons = {}

local function renderPage()
	local data = PAGES[currentTab] or PAGES.Self
	clearChildren(leftScroll)
	clearChildren(rightScroll)

	for i, item in ipairs(data.left) do
		if item.kind == "sec" then
			createSectionHeader(leftScroll, item.title, i)
		elseif item.kind == "tog" then
			createToggleItem(leftScroll, item, i)
		end
	end

	for i, item in ipairs(data.right) do
		if item.kind == "sec" then
			createSectionHeader(rightScroll, item.title, i)
		elseif item.kind == "tog" then
			createToggleItem(rightScroll, item, i)
		end
	end

	local isSelf = (currentTab == "Self")
	selfBtn.TextColor3 = isSelf and UI.Text or UI.SubText
	othersBtn.TextColor3 = (not isSelf) and UI.Text or UI.SubText
	TweenService:Create(modeUnderline, TweenInfo.new(0.14), {
		Position = isSelf and UDim2.new(0, 8, 1, -2) or UDim2.new(0.5, 8, 1, -2)
	}):Play()
end

for idx, ico in ipairs(RAIL_ICONS) do
	local btn = Instance.new("TextButton")
	btn.Size = UDim2.new(0, 26, 0, 26)
	btn.LayoutOrder = idx
	btn.BackgroundColor3 = (idx == 1) and UI.ActiveSoft or UI.RowBg
	btn.BackgroundTransparency = 0.25
	btn.Text = ico
	btn.TextColor3 = (idx == 1) and UI.Text or UI.SubText
	btn.Font = Enum.Font.GothamBold
	btn.TextSize = 12
	btn.Parent = leftRail
	Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 5)
	table.insert(railButtons, btn)

	btn.MouseButton1Click:Connect(function()
		selectedRail = idx
		for i, b in ipairs(railButtons) do
			local sel = (i == selectedRail)
			b.BackgroundColor3 = sel and UI.ActiveSoft or UI.RowBg
			b.TextColor3 = sel and UI.Text or UI.SubText
		end
		headerIconLbl.Text = ico
		winTitle.Text = "Category #" .. tostring(idx)
	end)
end

selfBtn.MouseButton1Click:Connect(function()
	currentTab = "Self"
	renderPage()
end)

othersBtn.MouseButton1Click:Connect(function()
