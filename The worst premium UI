local function createToggleItem(parent, cfg, order)
	local row = Instance.new("Frame")
	row.Size = UDim2.new(1, 0, 0, 24)
	row.LayoutOrder = order
	row.BackgroundColor3 = UI.RowBg
	row.BackgroundTransparency = 0.3
	row.BorderSizePixel = 0
	row.Parent = parent
	Instance.new("UICorner", row).CornerRadius = UDim.new(0, 4)

	local label = Instance.new("TextLabel")
	label.Size = UDim2.new(1, -110, 1, 0)
	label.Position = UDim2.new(0, 8, 0, 0)
	label.BackgroundTransparency = 1
	label.Text = cfg.name
	label.TextXAlignment = Enum.TextXAlignment.Left
	label.TextColor3 = UI.Text
	label.Font = Enum.Font.Gotham
	label.TextSize = 11
	label.Parent = row

	local rightOffset = 34
	if cfg.tag then
		local badge = Instance.new("TextLabel")
		badge.Size = UDim2.new(0, 46, 0, 14)
		badge.Position = UDim2.new(1, -86, 0.5, -7)
		badge.BackgroundColor3 = UI.BadgeBg
		badge.Text = cfg.tag
		badge.TextColor3 = UI.SubText
		badge.Font = Enum.Font.Gotham
		badge.TextSize = 9
		badge.Parent = row
		Instance.new("UICorner", badge).CornerRadius = UDim.new(0, 3)
		rightOffset = 34
	end

	if cfg.arrow then
		local arrow = Instance.new("TextLabel")
		arrow.Size = UDim2.new(0, 12, 0, 14)
		arrow.Position = UDim2.new(1, cfg.tag and -100 or -48, 0.5, -7)
		arrow.BackgroundTransparency = 1
		arrow.Text = "^"
		arrow.TextColor3 = UI.SubText
		arrow.Font = Enum.Font.GothamBold
		arrow.TextSize = 10
		arrow.Parent = row
	end

	local switch = Instance.new("TextButton")
	switch.Size = UDim2.new(0, 26, 0, 12)
	switch.Position = UDim2.new(1, -32, 0.5, -6)
	switch.BackgroundColor3 = UI.SwitchOff
	switch.Text = ""
	switch.Parent = row
	Instance.new("UICorner", switch).CornerRadius = UDim.new(1, 0)

	local knob = Instance.new("Frame")
	knob.Size = UDim2.new(0, 8, 0, 8)
	knob.Position = UDim2.new(0, 2, 0.5, -4)
	knob.BackgroundColor3 = UI.Knob
	knob.Parent = switch
	Instance.new("UICorner", knob).CornerRadius = UDim.new(1, 0)

	local active = false
	switch.MouseButton1Click:Connect(function()
		active = not active
		TweenService:Create(switch, TweenInfo.new(0.12), {
			BackgroundColor3 = active and UI.SwitchOn or UI.SwitchOff
		}):Play()
		TweenService:Create(knob, TweenInfo.new(0.12), {
			Position = active and UDim2.new(1, -10, 0.5, -4) or UDim2.new(0, 2, 0.5, -4)
		}):Play()
		winDesc.Text = cfg.name .. (active and " : ON" or " : OFF")
	end)
end

