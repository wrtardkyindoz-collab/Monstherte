-- Bien quan ly trang thai & ket noi cua tung chuc nang
local savedCFrame = nil
local conns = {}
local waterPart = nil

local function stopConn(key)
	if conns[key] then
		conns[key]:Disconnect()
		conns[key] = nil
	end
end

local function removeWaterPart()
	if waterPart and waterPart.Parent then
		waterPart:Destroy()
	end
	waterPart = nil
end

local Actions = {
	["Anti Ragdoll"] = function(state)
		stopConn("ragdoll")
		if state then
			conns.ragdoll = RunService.Stepped:Connect(function()
				local char = player.Character
				local hum = char and char:FindFirstChildOfClass("Humanoid")
				if hum then
					hum:SetStateEnabled(Enum.HumanoidStateType.Ragdoll, false)
					hum:SetStateEnabled(Enum.HumanoidStateType.FallingDown, false)
					if hum:GetState() == Enum.HumanoidStateType.Ragdoll or hum:GetState() == Enum.HumanoidStateType.FallingDown then
						hum:ChangeState(Enum.HumanoidStateType.GettingUp)
					end
				end
				if char then
					for _, desc in ipairs(char:GetDescendants()) do
						if desc:IsA("BallSocketConstraint") or desc:IsA("HingeConstraint") then
							desc.Enabled = false
						end
					end
				end
			end)
			return "Anti Ragdoll ON"
		end
		return "Anti Ragdoll OFF"
	end,

	["Anti Grab"] = function(state)
		stopConn("grab")
		if state then
			conns.grab = RunService.Heartbeat:Connect(function()
				local char = player.Character
				local hrp = char and char:FindFirstChild("HumanoidRootPart")
				if hrp then
					for _, obj in ipairs(hrp:GetChildren()) do
						if obj:IsA("BodyPosition") or obj:IsA("BodyGyro") or obj:IsA("BodyVelocity") or obj:IsA("AlignPosition") or obj:IsA("AlignOrientation") or obj:IsA("WeldConstraint") then
							if obj.Name ~= "RootJoint" then
								pcall(function() obj:Destroy() end)
							end
						end
					end
				end
			end)
			return "Anti Grab ON"
		end
		return "Anti Grab OFF"
	end,

	["Lock Position"] = function(state)
		stopConn("lockpos")
		if state then
			local char = player.Character
			local hrp = char and char:FindFirstChild("HumanoidRootPart")
			local targetCF = savedCFrame or (hrp and hrp.CFrame)
			if targetCF then
				conns.lockpos = RunService.Heartbeat:Connect(function()
					local c = player.Character
					local root = c and c:FindFirstChild("HumanoidRootPart")
					if root then
						root.CFrame = targetCF
						root.AssemblyLinearVelocity = Vector3.zero
					end
				end)
				return "Lock Position ON"
			end
		end
		return "Lock Position OFF"
	end,

	["Save Position"] = function(state)
		if state then
			local char = player.Character
			local hrp = char and char:FindFirstChild("HumanoidRootPart")
			if hrp then
				savedCFrame = hrp.CFrame
				return "Da luu vi tri hien tai"
			end
			return "Khong tim thay HRP"
		end
		return "Save Position OFF"
	end,

