-- Logo Mhert o goc tren trai (thay cho icon ca phe)
local function makeLogo(parent, sizePx, posUDim2)
	local box = Instance.new("Frame")
	box.Size = UDim2.new(0, sizePx, 0, sizePx)
	box.Position = posUDim2
	box.BackgroundColor3 = Color3.fromRGB(8, 10, 9)
	box.BorderSizePixel = 0
	box.Parent = parent
	Instance.new("UICorner", box).CornerRadius = UDim.new(0, 6)
	local st = Instance.new("UIStroke", box)
	st.Color = THEME.NeonGreen
	st.Thickness = 1.2

	local bars = {
		{x = 0.16, h = 0.72, top = 0.12},
		{x = 0.44, h = 0.80, top = 0.10},
		{x = 0.72, h = 0.64, top = 0.16}
	}
	for _, b in ipairs(bars) do
		local bar = Instance.new("Frame")
		bar.Size = UDim2.new(0.14, 0, b.h, 0)
		bar.Position = UDim2.new(b.x, 0, b.top, 0)
		bar.BackgroundColor3 = THEME.NeonGreen
		bar.BorderSizePixel = 0
		bar.Parent = box
		Instance.new("UICorner", bar).CornerRadius = UDim.new(1, 0)
	end
	return box
end

